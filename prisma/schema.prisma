generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Categoria {
  id        String           @id @default(cuid())
  nome      String           @unique
  tipo      String           @default("Servidor")
  servidors Servidor[]
  regras    RegraVantagem[]
  createdAt DateTime         @default(now())
}

model Cargo {
  id        String    @id @default(cuid())
  nome      String    @unique
  servidors Servidor[]
  createdAt DateTime  @default(now())
}

model Lotacao {
  id        String    @id @default(cuid())
  nome      String    @unique
  servidors Servidor[]
  createdAt DateTime  @default(now())
}

model RegraVantagem {
  id          String    @id @default(cuid())
  codigo      String    @unique
  nome        String
  descricao   String?
  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])
  tipo        String    @default("beneficio")
  ativo       Boolean   @default(true)
  obrigatorio Boolean   @default(false)
  valor       String?
  unidade     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BeneficioServidor {
  id          String   @id @default(cuid())
  servidorId  String
  servidor    Servidor @relation(fields: [servidorId], references: [id])
  codigo      String
  nome        String
  descricao   String?
  ativo       Boolean  @default(true)
  adquiridoEm DateTime?
  observacao  String?
  createdAt   DateTime @default(now())
}

model Servidor {
  id          String            @id @default(cuid())
  nome        String
  cpf         String            @unique
  rgcin       String?
  dtnasc      DateTime?
  sexo        String?
  tel         String?
  email       String?
  cargoId     String?
  cargo       Cargo?            @relation(fields: [cargoId], references: [id])
  categoriaId String?
  categoria   Categoria?        @relation(fields: [categoriaId], references: [id])
  faixa       String?
  nivel       String?
  jornada     String?
  lotacaoId   String?
  lotacao     Lotacao?          @relation(fields: [lotacaoId], references: [id])
  situacao    String            @default("Ativo")
  beneficios  BeneficioServidor[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Importacao {
  id           String          @id @default(cuid())
  nomeArquivo  String
  totalLinhas  Int
  registrosOK  Int
  registrosWarn Int
  registrosErr Int
  status       String
  createdAt    DateTime        @default(now())
  erros        ImportacaoErro[]
}

model ImportacaoErro {
  id           String      @id @default(cuid())
  importacaoId String
  importacao   Importacao  @relation(fields: [importacaoId], references: [id])
  linha        Int
  campo        String?
  mensagem     String
  createdAt    DateTime    @default(now())
}
